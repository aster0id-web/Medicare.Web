@model IEnumerable<MediCare.Data.Entities.MedicalSpecialization>
@{
    ViewData["Title"] = "Manage Specializations";
}

<div class="container mt-5">
    <h2 class="mb-4 text-danger">Manage Medical Specializations</h2>

    <!-- Form to Add a New Specialization -->
    <div class="card shadow-sm p-4 mb-5">
        <form asp-controller="Admin" asp-action="AddSpecialization" method="post" class="d-flex gap-3">
            <input type="text" name="specializationName" class="form-control" placeholder="E.g. Pediatrics, Cardiology, Psychiatry..." required />
            <button type="submit" class="btn btn-primary fw-bold px-4">Save</button>
        </form>
    </div>

    <!-- Table to Display Existing Specializations -->
    <h4 class="mb-3">Active Specializations</h4>
    <table class="table table-striped table-bordered shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Specialty Name</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var spec in Model)
                {
                    <tr>
                        <td>@spec.Name</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td class="text-muted fst-italic">No specializations found. Please add one above.</td>
                </tr>
            }
        </tbody>
    </table>
</div>