@{
    ViewData["Title"] = "Manage Users";
    var doctors = ViewBag.Doctors as IEnumerable<MediCare.Data.Entities.Doctor>;
    var patients = ViewBag.Patients as IEnumerable<MediCare.Data.Entities.Patient>;
}

<div class="container mt-5">
    <h2 class="mb-4 text-danger">Hospital Directory</h2>

    <div class="row">
        <!-- Doctors Table -->
        <div class="col-md-6">
            <h4 class="text-primary border-bottom pb-2">Registered Doctors</h4>
            <table class="table table-striped table-hover shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Doctor details</th>
                    </tr>
                </thead>
                <tbody>
                    @if (doctors != null && doctors.Any())
                    {
                        foreach (var doc in doctors)
                        {
                            <tr>
                                <td>@doc.Id</td>
                                <td>Account Registered</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Patients Table -->
        <div class="col-md-6">
            <h4 class="text-success border-bottom pb-2">Registered Patients</h4>
            <table class="table table-striped table-hover shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Patient details</th>
                    </tr>
                </thead>
                <tbody>
                    @if (patients != null && patients.Any())
                    {
                        foreach (var pat in patients)
                        {
                            <tr>
                                <td>@pat.Id</td>
                                <td>Account Registered</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>